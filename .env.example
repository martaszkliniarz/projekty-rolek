# Skopiuj ten plik jako .env i uzupełnij.

# Na własnym komputerze możesz zostawić DEBUG=1. Na serwerze w chmurze: DEBUG=0.
DEBUG=1

# Długi losowy ciąg znaków. Wygenerujesz go poleceniem:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=

# Na serwerze: adres strony, np. kancelaria.twojadomena.pl
ALLOWED_HOSTS=localhost,127.0.0.1
# Na serwerze: https://kancelaria.twojadomena.pl
CSRF_TRUSTED_ORIGINS=

# Folder z bazą danych i dokumentami — TEN folder trzeba robić w kopii zapasowej.
# DANE_DIR=/sciezka/do/danych

# Kalendarz Google: tajny fragment adresu kanału z terminami (pusty = wyłączone).
# Wygeneruj tak samo jak SECRET_KEY.
KALENDARZ_TOKEN=
# 1 = w Google tylko nr sprawy (bez nazwisk) — zalecane ze względu na tajemnicę adwokacką.
KALENDARZ_ANONIMOWY=1
